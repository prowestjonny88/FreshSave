{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/run-browser.mjs",
    "test:e2e:supabase": "node tests/e2e-supabase.mjs",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start --exclude studio,realtime,edge-runtime,imgproxy,logflare,vector,postgres-meta",
    "db:reset": "supabase db reset --local",
    "test:db": "supabase test db"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
